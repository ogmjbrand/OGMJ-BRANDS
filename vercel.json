{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=web",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/reconcile-video-renders",
      "schedule": "0 3 * * *"
    }
  ]
}
